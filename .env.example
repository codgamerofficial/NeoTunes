# NeoTunes Environment Variables Example
# Copy to .env.local for local development. Never commit sensitive keys!

# Application Environment
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3002

# API Port Configuration
PORT=3002

# Feature Flags
NEXT_PUBLIC_ENABLE_AI_ASSISTANT=true
NEXT_PUBLIC_ENABLE_SOCIAL=true
NEXT_PUBLIC_ENABLE_SPATIAL_AUDIO=true

# Amazon Bedrock Configuration (Server-Side Only - DO NOT expose to client)
BEDROCK_API_KEY=
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
BEDROCK_FALLBACK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
# Optional AWS Credentials for IAM Role / Local AWS Auth
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
