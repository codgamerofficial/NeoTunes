{
  "expo": {
    "name": "NeoTunes",
    "slug": "neotunes",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./public/favicon.svg",
    "userInterfaceStyle": "dark",
    "plugins": [
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./public/favicon.svg",
        "backgroundColor": "#0A0D14"
      }
    }
  }
}
